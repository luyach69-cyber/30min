from datetime import datetime
import os
import sqlite3
import time
import pandas as pd
import requests

DB_PATH = 'tw_stock_history.db'
TG_BOT_TOKEN = os.getenv('TG_BOT_TOKEN', '你的_BOT_TOKEN')
TG_CHAT_ID = os.getenv('TG_CHAT_ID', '你的_CHAT_ID')


def send_telegram_message(message: str):
    if not TG_BOT_TOKEN or TG_BOT_TOKEN == '你的_BOT_TOKEN' or not TG_CHAT_ID or TG_CHAT_ID == '你的_CHAT_ID':
        print(message)
        return
    url = f'https://api.telegram.org/bot{TG_BOT_TOKEN}/sendMessage'
    requests.post(
        url,
        json={'chat_id': TG_CHAT_ID, 'text': message, 'parse_mode': 'Markdown', 'disable_web_page_preview': True},
        timeout=10,
    )


def fetch_realtime_quotes(stock_ids: list) -> dict:
    """透過證交所 MIS 即時報價接口抓取觀察名單最新成交價"""
    if not stock_ids:
        return {}
    # 組合上市股票查詢字串 (tse_1717.tw|tse_1809.tw...)
    ex_ch = '|'.join([f'tse_{sid}.tw' for sid in stock_ids])
    url = f'https://mis.twse.com.tw/stock/api/getStockInfo.jsp?ex_ch={ex_ch}&json=1&delay=0'
    headers = {'User-Agent': 'Mozilla/5.0'}

    try:
        res = requests.get(url, headers=headers, timeout=10).json()
    except Exception as e:
        print(f'即時報價連線失敗: {e}')
        return {}

    quotes = {}
    for item in res.get('msgArray', []):
        sid = item.get('c')
        # z 為最新成交價，若盤中暫無撮合則退回參考昨收 y 或最佳買價 b
        price_str = item.get('z')
        if not price_str or price_str == '-':
            b_prices = item.get('b', '').split('_')
            price_str = b_prices[0] if b_prices and b_prices[0] else item.get('y')
        try:
            quotes[sid] = float(price_str)
        except (ValueError, TypeError):
            continue
    return quotes


def check_entry_alerts():
    """檢查近 5 個交易日內選出的 PENDING 標的，是否已跌至或觸及建議進場價"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    # 確保資料表存在
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS watchlist_signals (
            signal_date TEXT,
            stock_id TEXT,
            stock_name TEXT,
            signal_close REAL,
            suggested_entry REAL,
            stop_loss REAL,
            status TEXT DEFAULT 'PENDING',
            triggered_date TEXT,
            triggered_price REAL,
            PRIMARY KEY (signal_date, stock_id)
        )
    """)

    # 撈出近 5 天內尚未觸發的觀察標的
    df_pending = pd.read_sql_query(
        """
        SELECT * FROM watchlist_signals 
        WHERE status = 'PENDING' 
        ORDER BY signal_date DESC
        """,
        conn,
    )

    if df_pending.empty:
        print('目前無待監控的觀察標的。')
        conn.close()
        return

    stock_ids = df_pending['stock_id'].unique().tolist()
    quotes = fetch_realtime_quotes(stock_ids)
    now_str = datetime.now().strftime('%Y-%m-%d %H:%M')

    triggered_alerts = []
    for _, row in df_pending.iterrows():
        sid = row['stock_id']
        curr_price = quotes.get(sid)
        if curr_price is None:
            continue

        entry_price = float(row['suggested_entry'])
        stop_loss = float(row['stop_loss'])

        # 觸發條件：盤中現價 <= 建議進場價，且尚未跌破防守停損價 (避免接刀)
        if stop_loss < curr_price <= entry_price:
            cursor.execute(
                """
                UPDATE watchlist_signals 
                SET status = 'TRIGGERED', triggered_date = ?, triggered_price = ?
                WHERE signal_date = ? AND stock_id = ?
                """,
                (now_str, curr_price, row['signal_date'], sid),
            )
            triggered_alerts.append(
                f"🚨 *【進場價達標提醒】{sid} {row['stock_name']}*\n"
                f"   盤中現價: `{curr_price}` (已達建議進場 `{entry_price}`)\n"
                f"   防守停損: `{stop_loss}` | 訊號日: `{row['signal_date']}`\n"
                f"   👉 [立即看盤](https://tw.stock.yahoo.com/quote/{sid})"
            )

    conn.commit()
    conn.close()

    if triggered_alerts:
        msg = f'🔔 *盤中到價監控通知 ({now_str})*\n\n' + '\n\n'.join(triggered_alerts)
        send_telegram_message(msg)
        print(f'✅ 已發送 {len(triggered_alerts)} 筆到價提醒！')
    else:
        print(f'[{now_str}] 監控中 ({len(stock_ids)} 檔)，尚未觸及建議進場價。')


if __name__ == '__main__':
    check_entry_alerts()
